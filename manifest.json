{
  "manifest_version": 3,
  "name": "PoE Trade Helper",
  "version": "0.5.0",
  "description": "Bookmark folders, saved trade listings, fuzzy stat search and chaos/divine conversion for the Path of Exile trade site.",

  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "PoE Trade Helper"
  },

  "background": {
    "service_worker": "src/background/service-worker.js",
    "scripts": ["src/background/service-worker.js"],
    "type": "module"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "{062cd1af-e9b3-47ae-a9aa-8652f7c1299a}",
      "strict_min_version": "109.0"
    }
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.pathofexile.com/trade*",
        "https://pathofexile.com/trade*"
      ],
      "js": [
        "src/content/store.js",
        "src/content/location.js",
        "src/content/icons.js",
        "src/content/ui.js",
        "src/content/search-panel.js",
        "src/content/exchange.js",
        "src/content/panel.js",
        "src/content/ratelimit-overlay.js",
        "src/content/bookmarks.js",
        "src/content/saved.js",
        "src/content/prices.js",
        "src/content/main.js"
      ],
      "css": ["src/content/panel.css"],
      "run_at": "document_idle"
    }
  ],

  "permissions": ["storage", "activeTab"],

  "host_permissions": ["https://poe.ninja/*"],

  "web_accessible_resources": [
    {
      "resources": ["src/assets/icons/bookmark-folder/*.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
